-/* MCF5206EUM table 3-11: branch prediction depends on displacement sign.
- * The static table contributes three cycles in each case. */
+/* MCF5445x 2-level conditional-branch predictor state (8-entry direct-mapped
+ * branch cache + 128-entry direct-mapped prediction table, 2-bit each). */
+extern uint8  m68k_bht_state[128];
+extern uint32 m68k_btb_tag[8];
+extern uint8  m68k_btb_valid[8];
+extern uint8  m68k_btb_state[8];
+extern uint64 m68k_bcc_count, m68k_btb_hits, m68k_bht_hits, m68k_mispredicts;
+
+/* MCF5445x branch timing: 0 cycles branch-cache correctly-taken, 1 cycle
+ * prediction-table correctly-taken/not-taken, 8 cycles misprediction. */
 static inline void m68ki_cf_bcc(m68ki_cpu_core* m68ki_cpu, int taken, int word)
 {
 	const sint offset = word ? MAKE_INT_16(OPER_I_16()) : MAKE_INT_8(REG_IR);
+	const uint32 pc = REG_PC;
+	const uint32 btb_idx = (pc >> 1) & 7;
+	const uint32 btb_tag = pc >> 4;
+	const uint32 bht_idx = (pc >> 1) & 127;
+	uint8 bts = (m68k_btb_valid[btb_idx] && m68k_btb_tag[btb_idx] == btb_tag) ? m68k_btb_state[btb_idx] : 1;
+	uint8 bhs = m68k_bht_state[bht_idx];
+	const int btb_taken = bts >= 2;
+
+	m68k_bcc_count++;
+	if(btb_taken && taken)
+	{
+		m68k_btb_hits++;            /* branch-cache correctly taken: 0 cycles */
+	}
+	else if((bhs >= 2) == taken)
+	{
+		m68k_bht_hits++;            /* prediction-table correct: 1 cycle */
+		ADD_CYCLES(1);
+	}
+	else
+	{
+		m68k_mispredicts++;         /* misprediction: 8 cycles */
+		ADD_CYCLES(8);
+	}
+
+	if(taken) { if(bts < 3) bts++; if(bhs < 3) bhs++; }
+	else      { if(bts > 0) bts--; if(bhs > 0) bhs--; }
+	m68k_btb_valid[btb_idx] = 1;
+	m68k_btb_tag[btb_idx] = btb_tag;
+	m68k_btb_state[btb_idx] = bts;
+	m68k_bht_state[bht_idx] = bhs;
+
 	if(taken)
 	{
 		if(word) REG_PC -= 2;
 		m68ki_trace_t0();
 		REG_PC += offset;
-		if(offset < 0) ADD_CYCLES(1);
 	}
-	else if(offset >= 0)
-		ADD_CYCLES(2);
 }
 
